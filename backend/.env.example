ENV=development

# Supabase (server only — never expose the service-role key)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_CONCURRENCY=2
GEMINI_MIN_INTERVAL_SECONDS=4
GEMINI_TIMEOUT_SECONDS=60

# Embeddings
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=./.model_cache

# CORS (comma-separated)
FRONTEND_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Upload limits
MAX_FILE_MB=1
MAX_FILES_PER_UPLOAD=20
MAX_PAGES=2
MAX_RESUMES_PER_USER=500

# Processing
MAX_TEXT_CHARS=30000
MIN_TEXT_CHARS=200
STALE_PROCESSING_MINUTES=10
WORKER_POLL_SECONDS=3

# Search
SEARCH_CANDIDATE_POOL=15
SEARCH_DEFAULT_TOP_K=10
SEARCH_MAX_TOP_K=25
SEARCH_RATE_LIMIT_PER_MIN=30

# Storage
SIGNED_URL_TTL_SECONDS=3600

# Integration tests only (test_isolation.py) — a dedicated test Supabase project
# TEST_SUPABASE_URL=
# TEST_SUPABASE_SERVICE_ROLE_KEY=
