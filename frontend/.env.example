VITE_SUPABASE_URL=https://xxxx.supabase.co
# The ANON public key only — never the service-role key
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000

# Client-side pre-check / display values (the server is the authority)
VITE_MAX_FILE_MB=1
VITE_MAX_FILES_PER_UPLOAD=20
VITE_MAX_PAGES=2
VITE_MAX_RESUMES_PER_USER=500
